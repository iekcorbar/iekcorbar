# ==== Iekcorbar .gitignore ====
# Dit bestand bepaalt wat er NIET in git mag. Alles hierbuiten (code, bronnen,
# documentatie en grondstoffen) gaat in de privé-GitHub-repo.

# --- bouw-zooi & dependencies: te zwaar en altijd opnieuw te maken ---
node_modules/
.next/
out/
dist/
target/
*.tsbuildinfo

# --- kant-en-klare producten: jars en zip's (staan op de server; herbouwen = mvn package) ---
*.jar
*.zip
*.war
*.exe

# --- PRIVÉ en speler-data: nooit naar internet ---
*PRIVE*
forgotten players/
headdatabase/
src/lib/db.json

# --- geheimen: wachtwoorden, sleutels, tokens ---
.env
.env.*
# ..behoud voorbeeldbestanden die bij een project horen:
!StaffHub/.env.example
*.pem
*.key
id_rsa*

# --- serverkopieën en tijdelijke upload-mappen ---
pluginset-aangepast/
upload-*/
output_browser/
_archief/

# --- logboeken en rommel ---
*.log
Thumbs.db
Desktop.ini
.DS_Store

# --- machina-specifieke instellingen ---
.claude/settings.local.json
mobile/.expo/

deploy/
# ..behalve de deploy-templates van StaffHub (Caddyfile/backup-docs):
!StaffHub/deploy/

__pycache__/

# NDA: getekende exemplaren zijn persoonsgegevens - nooit in git (alleen de blanco template staat in docs/nda/)
docs/nda/signed/

# archief/ = renders/onderzoek/snapshots die niet meer meedoen (nooit in git)
archief/
