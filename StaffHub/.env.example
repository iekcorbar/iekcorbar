# Eerste opstart: zet een willekeurige lange geheime string hier neer;
# die code één keer invullen op het login-scherm om de eerste owner aan te maken.
STAFFHUB_BOOTSTRAP=zet-hier-een-lang-geheim-neer

# WebDAV-tokens en sessies draaien via Caddy/Traefik die al TLS doet.
# Zet op 1 als je app alléén achter https draait (aanbevolen):
COOKIE_SECURE=1

# AI model voor de Boord-AI (standaard: beam-free via opencode-go)
# STAFFHUB_AI_URL=https://your-sandbox-url
# STAFFHUB_AI_PASS=your-password
# STAFFHUB_AI_MODEL=beam-free
# STAFFHUB_AI_PROVIDER=opencode-go

# Sync directory for markdown docs (default: /app/staffhub-quests)
# SYNC_DIR=/app/staffhub-quests

# Deploy checklist path (default: /app/deploy/TE-DEPLOYEN.txt)
# TE_DEPLOYEN_PATH=/app/deploy/TE-DEPLOYEN.txt

# Server status file path (default: /app/server-status.json)
# SERVER_STATUS_FILE=/app/server-status.json
