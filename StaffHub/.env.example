# Eerste opstart: zet een willekeurige lange geheime string hier neer;
# die code één keer invullen op het login-scherm om de eerste owner aan te maken.
STAFFHUB_BOOTSTRAP=zet-hier-een-lang-geheim-neer

# WebDAV-tokens en sessies draaien via Caddy/Traefik die al TLS doet.
# Zet op 1 als je app alléén achter https draait (aanbevolen):
COOKIE_SECURE=1
