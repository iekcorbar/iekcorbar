{
  "name": "staffhub-desktop",
  "version": "0.1.6",
  "private": true,
  "description": "StaffHub desktop-app: het staff-netwerk in één klik.",
  "author": "Iekcorbar",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.iekcorbar.staffhub",
    "productName": "StaffHub",
    "electronDist": "node_modules/electron/dist",
    "files": ["main.js", "config.json"],
    "win": { "target": "nsis", "signAndEditExecutable": true, "signingHashAlgorithms": ["sha256"], "publisherName": ["Iekcorbar StaffHub"] }
  }
}
