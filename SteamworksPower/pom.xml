<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.iekcorbar</groupId>
    <artifactId>SteamworksPower</artifactId>
    <!-- Power add-on for Steamworks: water turbine, mechanical press, stock ticker, flywheel
         and sieve funnel. Joins the rotation network through Steamworks' public CustomPart API. -->
    <version>0.2.0</version>
    <packaging>jar</packaging>
    <!-- STILSTANDENDE MODULE (10-11): de power-machines zijn sinds Steamworks 0.3.34 ingebouwd
         in de core (com.iekcorbar.power.*). Draait deze addon-jar naast Steamworks, dan botsen
         ze: beide declareren /swpower, ExtParts.register() weigert ("already registered") en
         machines krijgen dubbele recepten. NIET MEER DEPLOYEN. -->

    <name>SteamworksPower</name>

    <properties>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <paper.api.version>26.2.build.135-stable</paper.api.version>
        <!-- keep in step with Steamworks/pom.xml (see the dependency note below) -->
        <steamworks.version>0.3.41</steamworks.version>
    </properties>

    <repositories>
        <repository>
            <id>papermc-repo</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>${paper.api.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- Steamworks' public API (com.iekcorbar.steamworks.api.*). The jar ships with the build,
             the server loads it from the Steamworks plugin itself. BUILD ORDER: run `mvn package`
             in Steamworks/ FIRST, then keep steamworks.version in sync with Steamworks' own pom
             (a stale pin here used to break the Power build silently - 10-11: 0.3.40 vs 0.3.41). -->
        <dependency>
            <groupId>com.iekcorbar</groupId>
            <artifactId>Steamworks</artifactId>
            <version>${steamworks.version}</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/../Steamworks/target/Steamworks-${steamworks.version}.jar</systemPath>
        </dependency>
        <!-- pinned to the version already in the local repo (paper-api pulls a newer one transitively) -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.10.1</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>25</source>
                    <target>25</target>
                </configuration>
            </plugin>

        </plugins>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>plugin.yml</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>plugin.yml</exclude>
                </excludes>
            </resource>
        </resources>
    </build>
</project>
